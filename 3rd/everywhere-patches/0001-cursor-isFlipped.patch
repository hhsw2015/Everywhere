 private final class SoftwareCursorView: NSView {
+    // Everywhere downstream patch: NSView default isFlipped=false (y-up).
+    // OCCU expects that and pre-flips Y in appKitDrawingState. Inside the
+    // Avalonia-hosted .NET process the cursor renders upside-down — likely
+    // a layer-backed-view geometry difference from OCCU's standalone host.
+    // Forcing y-down here puts both surfaces on the same axis and cancels
+    // appKitDrawingState's pre-flip cleanly. If you re-sync upstream OCCU,
+    // re-apply this override.
+    override var isFlipped: Bool { true }
