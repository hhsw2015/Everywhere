<Project>
  <!--
    Builds the small Rust binary `tools/everywhere-context-hook` that the Claude Code
    UserPromptSubmit hook calls to read + delete the context-stash JSON. Output lands
    inside the macOS app bundle at Contents/Helpers/everywhere-context-hook.

    Cargo's release-mode binary is ~280 KB and starts in ~3 ms — it's invoked on
    every Enter key, so size and cold-start time both matter.
  -->

  <PropertyGroup>
    <ContextHookSrcDir>$(MSBuildThisFileDirectory)../tools/everywhere-context-hook</ContextHookSrcDir>
    <ContextHookBinName Condition="'$(IsWindows)' == 'true'">everywhere-context-hook.exe</ContextHookBinName>
    <ContextHookBinName Condition="'$(IsWindows)' != 'true'">everywhere-context-hook</ContextHookBinName>
    <!-- Cargo target dir defaults to <crate>/target; some setups override via env. -->
    <ContextHookTargetDir Condition="'$(CARGO_TARGET_DIR)' != ''">$(CARGO_TARGET_DIR)</ContextHookTargetDir>
    <ContextHookTargetDir Condition="'$(ContextHookTargetDir)' == ''">$(ContextHookSrcDir)/target</ContextHookTargetDir>
    <ContextHookExecutable>$(ContextHookTargetDir)/release/$(ContextHookBinName)</ContextHookExecutable>
  </PropertyGroup>

  <!-- Run BEFORE the SDK resolves None items, so the binary exists when the
       <None Include="$(ContextHookExecutable)"> in the consuming csproj is
       evaluated for publish. Mirrors what Build.Watchdog.targets does for
       the watchdog binary. -->
  <Target Name="BuildEverywhereContextHook"
          BeforeTargets="BeforeResolveReferences"
          Inputs="$(ContextHookSrcDir)/src/main.rs;$(ContextHookSrcDir)/Cargo.toml"
          Outputs="$(ContextHookExecutable)">
    <Message Text="Building Rust context hook in $(ContextHookSrcDir)..." Importance="high" />
    <!-- Soft-fail when cargo isn't installed: host build proceeds without the
         hook binary; Mac/Win/Linux release CI all have cargo preinstalled. -->
    <Exec
      Command="cargo build --release --manifest-path &quot;$(ContextHookSrcDir)/Cargo.toml&quot;"
      ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ContextHookExitCode" />
    </Exec>
    <Message
      Condition="'$(ContextHookExitCode)' != '0'"
      Text="Rust context hook build skipped (cargo not available or build failed). The Snapshot Context hotkey works without it; only Claude Code prompt-injection misses out."
      Importance="high" />
  </Target>
</Project>
