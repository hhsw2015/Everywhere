<Project>
  <!--
    SPEC docs/specs/everywhere-connector.md §5 — build the open-connector
    provider bundle before C# compile, then ship the outputs into the
    daemon's publish tree as Resources/connector/.

    Mirrors Build.OpenCliBundle.targets structurally. The one addition:
    we invoke `node scripts/build-connector-bundle.mjs` in a BeforeBuild
    hook because the vendored TS sources need bundling before they can be
    consumed by ConnectorRuntime at runtime.

    Node ≥18 must be on PATH. If Node is missing, the bundle target
    fails loudly with an actionable message; C# compile is unaffected
    only if the dist/ output already exists on disk from a prior build.
  -->
  <PropertyGroup>
    <!-- Normalize every path so MSBuild sees a single canonical spelling.
         Previously "src/../3rd/..." and "3rd/..." both matched the same
         physical files but MSBuild's dedup treats them as distinct,
         producing NETSDK1152 "multiple publish output files with the
         same relative path". -->
    <_ConnectorSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../3rd/open-connector'))</_ConnectorSourceDir>
    <_ConnectorBundleScript>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../scripts/build-connector-bundle.mjs'))</_ConnectorBundleScript>
    <_ConnectorDistDir>$([MSBuild]::NormalizeDirectory('$(_ConnectorSourceDir)/dist'))</_ConnectorDistDir>
    <_ConnectorBundleOutput>$([MSBuild]::NormalizePath('$(_ConnectorDistDir)/connector.bundle.js'))</_ConnectorBundleOutput>
    <_ConnectorManifestOutput>$([MSBuild]::NormalizePath('$(_ConnectorDistDir)/connector-manifest.json'))</_ConnectorManifestOutput>
    <_ConnectorWebDir>$([MSBuild]::NormalizeDirectory('$(_ConnectorSourceDir)/web'))</_ConnectorWebDir>
    <_ConnectorWebDist>$([MSBuild]::NormalizeDirectory('$(_ConnectorDistDir)/web'))</_ConnectorWebDist>
    <_ConnectorWebIndex>$([MSBuild]::NormalizePath('$(_ConnectorWebDist)/index.html'))</_ConnectorWebIndex>
  </PropertyGroup>

  <!--
    Rebuild the bundle when the script or any vendored .ts under
    src/core or src/providers has a newer mtime than the emitted
    bundle. Using Inputs/Outputs lets MSBuild skip this on incremental
    builds when nothing changed.
  -->
  <ItemGroup>
    <_ConnectorBundleInput Include="$(_ConnectorBundleScript)" />
    <_ConnectorBundleInput Include="$(_ConnectorSourceDir)/src/**/*.ts" />
    <_ConnectorBundleInput Include="$(_ConnectorSourceDir)/UPSTREAM_SHA" />
  </ItemGroup>

  <Target Name="BuildConnectorBundle"
          BeforeTargets="PrepareForBuild"
          Inputs="@(_ConnectorBundleInput)"
          Outputs="$(_ConnectorBundleOutput);$(_ConnectorManifestOutput)"
          Condition="Exists('$(_ConnectorSourceDir)/src') and Exists('$(_ConnectorBundleScript)')">
    <Message Importance="high" Text="[connector] rebuilding provider bundle from $(_ConnectorSourceDir)" />
    <Exec Command="node &quot;$(_ConnectorBundleScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory).." />
  </Target>

  <!-- Vite build for the Web Console. Skipped when the vendored web/
       tree isn't present (contributor cloning with sparse subtree). CI
       runs it directly before dotnet so incremental MSBuild treats
       dist/web/index.html as the check. -->
  <ItemGroup>
    <_ConnectorWebInput Include="$(_ConnectorWebDir)/**/*.ts" />
    <_ConnectorWebInput Include="$(_ConnectorWebDir)/**/*.tsx" />
    <_ConnectorWebInput Include="$(_ConnectorWebDir)/index.html" />
    <_ConnectorWebInput Include="$(_ConnectorWebDir)/vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildConnectorWeb"
          BeforeTargets="PrepareForBuild"
          Inputs="@(_ConnectorWebInput)"
          Outputs="$(_ConnectorWebIndex)"
          Condition="Exists('$(_ConnectorWebDir)/package.json') and Exists('$(_ConnectorWebDir)/node_modules')">
    <Message Importance="high" Text="[connector] rebuilding web console from $(_ConnectorWebDir)" />
    <Exec Command="npx vite build"
          WorkingDirectory="$(_ConnectorWebDir)" />
  </Target>

  <ItemGroup Condition="Exists('$(_ConnectorDistDir)')">
    <Content Include="$(_ConnectorDistDir)/connector.bundle.js">
      <Link>Resources/connector/connector.bundle.js</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(_ConnectorDistDir)/connector-manifest.json">
      <Link>Resources/connector/connector-manifest.json</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(_ConnectorSourceDir)/UPSTREAM_SHA">
      <Link>Resources/connector/UPSTREAM_SHA</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(_ConnectorSourceDir)/UPSTREAM_REF" Condition="Exists('$(_ConnectorSourceDir)/UPSTREAM_REF')">
      <Link>Resources/connector/UPSTREAM_REF</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Web Console static assets. Enumerate + inject into ContentWithTargetPath
       INSIDE a target so the file discovery happens AFTER BuildConnectorWeb
       runs. A file-scope <ItemGroup> is evaluated at MSBuild load time,
       which is before vite writes dist/web/index.html; it would leave
       the collection empty forever.

       Uses ContentWithTargetPath (not Content) with a computed
       TargetPath to avoid a metadata-batching corner case where
       %(RecursiveDir)%(Filename)%(Extension) inside an in-target
       ItemGroup could be resolved against the wrong anchor and produce
       duplicated LogicalName values (e.g. an opencli adapter's path
       leaking into connector/web/*). Two-step "Include then Update
       TargetPath" keeps every item's TargetPath deterministic. -->
  <Target Name="_CollectConnectorWebAssets"
          AfterTargets="BuildConnectorWeb"
          BeforeTargets="AssignTargetPaths;_HandlePackageFileConflicts"
          Condition="Exists('$(_ConnectorWebIndex)') and '$(_ConnectorWebAssetsCollected)' != 'true'">
    <PropertyGroup>
      <!-- Guard so the target's ItemGroup only runs once even if MSBuild
           schedules the target on multiple entry points (AssignTargetPaths
           can be called several times during a publish). Without this
           guard the same 3 files land in Content 3-4 times → NETSDK1152. -->
      <_ConnectorWebAssetsCollected>true</_ConnectorWebAssetsCollected>
    </PropertyGroup>
    <ItemGroup>
      <Content Include="$(_ConnectorWebDist)/**/*">
        <Link>Resources/connector/web/%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <!-- macOS Xamarin bundler needs an explicit PublishFolderType so
             the file lands under Contents/Resources/. -->
        <PublishFolderType>Resource</PublishFolderType>
      </Content>
    </ItemGroup>
  </Target>
</Project>
