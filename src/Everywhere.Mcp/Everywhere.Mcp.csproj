<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Everywhere.Mcp</RootNamespace>
    <IsDeploymentTarget>true</IsDeploymentTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="VersOne.Epub" />
    <PackageReference Include="AngleSharp" />

    <!-- ClearScript V8 — OpenCLI adapter runtime (SPEC §8 Phase 0).
         The platform .Native.* packages ship the right .dylib/.so/.dll
         per-RID via the publish step. -->
    <PackageReference Include="Microsoft.ClearScript.V8" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Everywhere.Abstractions\Everywhere.Abstractions.csproj" />
    <ProjectReference Include="..\Everywhere.Core\Everywhere.Core.csproj" />
    <ProjectReference Include="..\Everywhere.Terminal\Everywhere.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 1:1 OCCU CursorPanel uses the bundled "official-software-cursor-
         window-252.png" as the primary glyph (NSImage rotate/scale at
         draw time). Source: open-computer-use@0.1.53 MIT. -->
    <EmbeddedResource Include="CursorOverlay\Assets\official-software-cursor-window-252.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 4 chat bus tests reach an internal test hook on OpenDiaBridge
         to simulate WebSocket push frames without a live extension. -->
    <InternalsVisibleTo Include="Everywhere.Mcp.Tests" />
  </ItemGroup>
</Project>
